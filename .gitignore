.DS_Store
.venv/
__pycache__/
src/*.egg-info/
*.py[cod]

# Downloaded corpora, model caches, and generated measurements are local artifacts.
data/
models/
results/*.jsonl
results/*.json
results/**/*.jsonl
results/**/*.json
!results/.gitkeep

# XcodeGen recreates this project from runners/xcode/project.yml. Keep derived
# data in the external benchmark cache, never in the repository.
runners/xcode/*.xcodeproj/
